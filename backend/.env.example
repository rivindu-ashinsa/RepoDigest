# Environment Configuration Example
# Copy this file to .env and fill in your actual API keys

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=x-ai/grok-code-fast-1

# HuggingFace Configuration
HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Site Configuration (optional - for OpenRouter ranking)
SITE_URL=http://localhost:8000
SITE_NAME=Agentic AI Application

# Application Configuration
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Efficiency / Cost Controls
MAX_FILE_CONTENT_CHARS=3500
MAX_FILES_TO_SUMMARIZE=45
SUMMARIZER_MAX_OUTPUT_TOKENS=420
README_MAX_OUTPUT_TOKENS=1400
README_MAX_SUMMARY_CHARS=22000
